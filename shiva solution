        function formatArticleContent(text) {
            if (!text) return '<p class="text-slate-400">No content provided.</p>';
            
            const lines = text.split('\n');
            let output = [];
            let inList = false;

            for (let line of lines) {
                line = line.trim();
                if (!line) {
                    if (inList) { output.push('</ul>'); inList = false; }
                    continue;
                }

                if (line.startsWith('### ')) {
                    if (inList) { output.push('</ul>'); inList = false; }
                    output.push(`<h3 class="text-lg font-bold text-white mt-4 mb-2 flex items-center gap-2">${escapeHtml(line.replace('### ', ''))}</h3>`);
                } else if (line.startsWith('## ')) {
                    if (inList) { output.push('</ul>'); inList = false; }
                    output.push(`<h2 class="text-xl font-black text-amber-400 mt-6 mb-3">${escapeHtml(line.replace('## ', ''))}</h2>`);
                } else if (line.startsWith('- ') || line.startsWith('* ')) {
                    if (!inList) {
                        output.push('<ul class="space-y-1.5 list-disc list-inside text-slate-300 my-2">');
                        inList = true;
                    }
                    output.push(`<li>${escapeHtml(line.substring(2))}</li>`);
                } else {
                    if (inList) { output.push('</ul>'); inList = false; }
                    output.push(`<p class="leading-relaxed text-slate-300 mb-3">${escapeHtml(line)}</p>`);
                }
            }

            if (inList) { output.push('</ul>'); }
            return output.join('');
        }

