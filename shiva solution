            if (!inputPin) return;

            const expectedPin = localStorage.getItem('shiva_owner_pin') || 'shiv21212929@';

            // Function to grant owner access
            const grantAccess = () => {
                currentOwnerPasskey = inputPin;
                sessionStorage.setItem('shiva_owner_auth', 'true');
