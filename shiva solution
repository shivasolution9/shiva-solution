        function handleBlogSubmit(e) {
            e.preventDefault();

            if (!isOwnerLoggedIn()) {
                alert('Unauthorized: Only the owner proprietor can publish or edit blogs.');
                return;
            }

            const blogId = document.getElementById('formBlogId').value.trim();
            const title = document.getElementById('formTitle').value.trim();
            const category = document.getElementById('formCategory').value;
            const emoji = document.getElementById('formEmoji').value;
            const author = document.getElementById('formAuthor').value.trim() || 'SHIVA SOLUTION Editorial';
            const readTime = document.getElementById('formReadTime').value.trim() || '4 min read';
            const excerpt = document.getElementById('formExcerpt').value.trim();
            const content = document.getElementById('formContent').value.trim();
            const keywordsRaw = document.getElementById('formKeywords').value.trim();

            const keywords = keywordsRaw ? keywordsRaw.split(',').map(s => s.trim()).filter(Boolean) : ['SHIVA SOLUTION', 'cricket', 'today live match'];

            let blogs = getStoredBlogs();
            let blogToSync = null;

            if (blogId) {
                const index = blogs.findIndex(b => b.id === blogId);
                if (index !== -1) {
                    blogs[index] = {
                        ...blogs[index],
                        title,
                        category,
                        emoji,
                        author,
                        readTime,
                        excerpt,
                        content,
                        keywords,
                        date: 'Recently Edited'
                    };
                    blogToSync = blogs[index];
                    saveStoredBlogs(blogs);
                    showToast('✅ Blog post updated successfully by Owner!');
                }
            } else {
                const newBlog = {
                    id: 'blog-' + Date.now(),
                    title,
                    category,
                    emoji,
                    author,
                    readTime,
                    excerpt,
                    content,
                    keywords,
                    date: 'Just Now'
                };
                blogToSync = newBlog;
                blogs.unshift(newBlog);
                saveStoredBlogs(blogs);
                showToast('🎉 New blog published successfully by Owner!');
            }

            // Sync with backend API
            if (blogToSync) {
                fetch('/api/blogs', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Owner-Pin': getOwnerPin()
                    },
                    body: JSON.stringify(blogToSync)
                }).catch(e => console.log('API server sync:', e));
            }

