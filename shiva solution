    <!-- JAVASCRIPT: LEAD CAPTURE, REDIRECTIONS & DEMO LOGIC -->
    <script>
        const OFFICIAL_PHONE = '918401375861';
        const BACKEND_API_URL = '/api/leads';

        // SECURE LEAD SUBMISSION (SAVED DIRECTLY TO BACKEND DATABASE FOLDER)
        async function handleLeadSubmit(event, source) {
            event.preventDefault();
            let phone = '';
            let name = 'Customer';
            let preferences = [];
            let feedbackEl = null;

            if (source === 'hero') {
                phone = document.getElementById('heroUserPhone').value.trim();
                feedbackEl = document.getElementById('heroLeadFeedback');
                const checkedBoxes = document.querySelectorAll('input[name="alertPref"]:checked');
                checkedBoxes.forEach(cb => preferences.push(cb.value));
            } else {
                phone = document.getElementById('sectionUserPhone').value.trim();
                name = document.getElementById('sectionUserName').value.trim() || 'Customer';
                feedbackEl = document.getElementById('sectionLeadFeedback');
                preferences = ['All Sports Alerts'];
            }

            if (!phone || phone.length < 10) {
                alert('Please enter a valid 10-digit mobile number.');
                return;
            }

            const prefString = preferences.join(', ') || 'Cricket Live';
            const leadData = {
                phone: phone,
                name: name,
                preferences: prefString,
                source: source === 'hero' ? 'Hero Lead Box' : 'Join Us Section'
            };

            // 1. Send to local backend server to save in database/leads.csv & database/leads.json
            try {
                fetch(BACKEND_API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(leadData)
                }).catch(err => {
                    console.log('Backend sync (server may be offline):', err);
                });
            } catch (err) {
                console.log(err);
            }

            // 2. Immediate feedback in UI (Zero client-side leak of previous leads!)
            if (feedbackEl) {
                feedbackEl.classList.remove('hidden');
                feedbackEl.innerHTML = `
                    <div class="flex items-center justify-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></span>
                        <span>✅ Mobile <strong>+91 ${phone}</strong> verified! Connecting to official desk...</span>
                    </div>
                `;
            }

            // 3. Immediately open chat redirect with prefilled text to official Alert Desk
            const textMsg = `HELLO SHIVA SOLUTION! I WANT TO JOIN US NOW. PLEASE ACTIVATE SPORTS ALERTS FOR MY MOBILE: +91 ${phone} (${prefString})`;
            const redirectUrl = `https://wa.me/${OFFICIAL_PHONE}?text=${encodeURIComponent(textMsg)}`;

            setTimeout(() => {
                window.open(redirectUrl, '_blank');
            }, 800);
        }

        // SIMULATOR TRIGGER
