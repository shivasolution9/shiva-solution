        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // ================= CRICBUZZ LIVE WIRE CLIENT ENGINE =================
        let currentCricbuzzTab = 'scores';
        let cricbuzzMatches = [];
        let cricbuzzNews = [];

        async function fetchApiData(endpoints) {
            for (const ep of endpoints) {
                try {
                    const res = await fetch(ep);
                    if (res.ok) {
                        const data = await res.json();
                        if (data) return data;
                    }
                } catch (e) {}
            }
            return null;
        }

        async function loadCricbuzzScores() {
            const data = await fetchApiData([
                '/api/live-scores',
                'http://localhost:5000/api/live-scores',
                'http://localhost:8080/api/live-scores',
                'database/live_scores.json'
            ]);

            if (data) {
                const matches = data.matches || (Array.isArray(data) ? data : []);
                if (matches.length > 0) {
                    cricbuzzMatches = matches;
                    renderLiveScores(matches);
                    renderTickerScores(matches);
                }
            }
        }

        async function loadBallByBallTelemetry() {
            const data = await fetchApiData([
                '/api/ball-by-ball',
                'http://localhost:5000/api/ball-by-ball',
                'http://localhost:8080/api/ball-by-ball',
                'database/ball_by_ball.json'
            ]);

            if (data) {
                const telemetry = data.telemetry || data;
                renderBallByBallTelemetry(telemetry);
            }
        }

        function renderBallByBallTelemetry(t) {
            if (!t) return;
            const titleEl = document.getElementById('bbbMatchTitle');
            const b1El = document.getElementById('bbbBatter1');
            const b2El = document.getElementById('bbbBatter2');
            const bowEl = document.getElementById('bbbBowler');
            const bowFigEl = document.getElementById('bbbBowlerFigures');
            const ballsEl = document.getElementById('bbbRecentBalls');
            const partEl = document.getElementById('bbbPartnership');
            const lastWktEl = document.getElementById('bbbLastWicket');

            if (titleEl && (t.match_title || t.headline_score)) {
                titleEl.textContent = t.match_title || t.headline_score.split('(')[0].trim();
            }

            if (b1El && t.batsman_1) {
                const parts = t.batsman_1.split('*');
                const name = parts[0] ? parts[0].trim() : t.batsman_1;
                const score = parts[1] ? '*' + parts[1].trim() : '';
                b1El.innerHTML = `<span>${escapeHtml(name)}</span> <span class="text-amber-400 font-mono">${escapeHtml(score || t.batsman_1)}</span>`;
            }

            if (b2El && t.batsman_2) {
                const parts = t.batsman_2.split('*');
                const name = parts[0] ? parts[0].trim() : t.batsman_2;
                const score = parts[1] ? '*' + parts[1].trim() : '';
                b2El.innerHTML = `<span>${escapeHtml(name)}</span> <span class="text-slate-400 font-mono">${escapeHtml(score || t.batsman_2)}</span>`;
            }

            if (bowEl && t.bowler) {
                bowEl.textContent = t.bowler.split('(')[0].trim();
            }
            if (bowFigEl && t.bowler) {
                const paren = t.bowler.match(/\(([^)]+)\)/);
                bowFigEl.textContent = paren ? paren[1] : (t.status || 'Active Over');
            }

            if (ballsEl && t.recent_balls) {
                const cleanBalls = t.recent_balls.replace(/\|/g, ' ').split(/\s+/).filter(Boolean);
                let ballHtml = '';
                cleanBalls.slice(-6).forEach(ball => {
                    let dotClass = 'ball-dot-normal';
                    if (ball === '4' || ball === '6') dotClass = 'ball-dot-boundary';
                    else if (ball.toLowerCase() === 'w' || ball.includes('W')) dotClass = 'ball-dot-wicket';
                    ballHtml += `<span class="ball-dot ${dotClass}">${escapeHtml(ball)}</span>`;
                });
                if (ballHtml) ballsEl.innerHTML = ballHtml;
            }

            if (partEl && t.partnership) {
                partEl.innerHTML = `🤝 <strong class="text-white">Partnership:</strong> ${escapeHtml(t.partnership)}`;
            }
            if (lastWktEl && t.last_wicket) {
                lastWktEl.innerHTML = `🧤 <strong class="text-white">Last Wicket:</strong> ${escapeHtml(t.last_wicket)}`;
            }
        }

        async function loadCricbuzzNews() {
            const data = await fetchApiData([
                '/api/live-news',
                'http://localhost:5000/api/live-news',
                'http://localhost:8080/api/live-news',
                'database/live_news.json'
            ]);

            if (data) {
                const news = data.news || (Array.isArray(data) ? data : []);
                if (news.length > 0) {
                    cricbuzzNews = news;
                    renderLiveNews(news);
                }
            }
        }

        function generateScorecardBoxHTML(m, index) {
            const isLive = m.is_live;
            const badgeText = isLive ? 'LIVE' : (m.status_badge || 'RESULT');
            const badgeClass = isLive 
                ? 'bg-red-600 text-white font-black animate-pulse' 
                : (m.status_badge === 'Stumps' ? 'bg-slate-200 text-slate-800 font-black' : 'bg-slate-200 text-slate-800 font-black');
            
            const team1Name = escapeHtml(m.team1_short || m.team1 || 'Team 1');
            const team2Name = escapeHtml(m.team2_short || m.team2 || 'Team 2');
            const team1Score = escapeHtml(m.team1_score || 'Score Pending');
            const team2Score = escapeHtml(m.team2_score || 'Yet to bat');
            const seriesTitle = escapeHtml(m.series || m.title || 'Cricket Match');
            const statusText = escapeHtml(m.status || (isLive ? 'Match in progress' : 'Live Coverage'));
            const cleanQuery = encodeURIComponent(`HELLO SHIVA SOLUTION! CRICKET ALERT FOR ${team1Name} vs ${team2Name}`);

            return `
                <a href="https://wa.me/918401375861?text=${cleanQuery}" target="_blank"
                   class="scorecard-chevron-box relative flex-shrink-0 w-[295px] p-3.5 pr-14 text-slate-950 block">
                    <div class="scorecard-left-notch"></div>
                    <div class="pl-2">
                        <div class="flex items-center justify-between text-[10px] font-mono mb-1.5">
                            <span class="font-extrabold text-slate-600 uppercase truncate max-w-[140px]">${seriesTitle}</span>
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full ${badgeClass} text-[9px] uppercase tracking-wider shadow-sm">
                                ${isLive ? '<span class="w-1.5 h-1.5 rounded-full bg-white"></span>' : ''} ${badgeText}
                            </span>
                        </div>
                        <div class="space-y-1 font-mono">
                            <div class="flex items-center justify-between">
                                <span class="font-black text-xs text-slate-900 flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full bg-blue-600"></span> ${team1Name}
                                </span>
                                <span class="font-black text-xs text-slate-950">${team1Score}</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="font-black text-xs text-slate-900 flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full bg-amber-500"></span> ${team2Name}
                                </span>
                                <span class="font-black text-xs text-amber-600">${team2Score}</span>
                            </div>
                        </div>
                        <div class="mt-2 pt-1.5 border-t border-slate-200/90 flex items-center justify-between text-[10px]">
                            <span class="font-bold text-emerald-700 truncate max-w-[170px]">⚡ ${statusText}</span>
                        </div>
                    </div>
                    <div class="scorecard-chevron-arrow">
                        <span class="text-[11px] font-mono font-black">${index + 1}</span>
                        <svg class="w-3.5 h-3.5 text-slate-950 font-black mt-0.5" fill="none" stroke="currentColor" stroke-width="3.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                    </div>
                </a>
            `;
        }

        function renderTickerScores(matches) {
            const ticker = document.getElementById('liveTickerContent');
            const heroTicker = document.getElementById('indexHeroScoreTicker');
            if ((!ticker && !heroTicker) || !matches || matches.length === 0) return;

            let items = [];
            let heroBoxes = [];
            matches.forEach((m, idx) => {
                const isLive = m.is_live;
                const color = isLive ? 'text-red-400 font-black' : 'text-amber-400 font-bold';
                const badge = isLive ? '🔴 LIVE' : (m.status_badge || 'SCORE');
                const scoreStr = m.team1_score ? `${m.team1_short || m.team1} ${m.team1_score} vs ${m.team2_short || m.team2} ${m.team2_score}` : `${m.team1} vs ${m.team2}`;
                items.push(`
                    <div class="flex items-center gap-2 whitespace-nowrap">
                        <span class="${color}">[${badge}] ${escapeHtml(m.team1_short || m.team1)} vs ${escapeHtml(m.team2_short || m.team2)}:</span>
                        <span>${escapeHtml(scoreStr)} &bull; ${escapeHtml(m.status)}</span>
                    </div>
                `);

                heroBoxes.push(generateScorecardBoxHTML(m, idx));
            });

            if (ticker) ticker.innerHTML = items.join('<span class="text-slate-600">&bull;</span>');
            if (heroTicker) heroTicker.innerHTML = heroBoxes.join('');
        }

        function renderLiveScores(matches) {
            const container = document.getElementById('cricbuzzScoresContainer');
            const badge = document.getElementById('liveMatchesCountBadge');
            if (badge) badge.textContent = matches.length;
            if (!container) return;

            if (!matches || matches.length === 0) {
                container.innerHTML = `<div class="col-span-3 text-center p-8 text-slate-400">Loading Cricbuzz Live Telemetry...</div>`;
                return;
            }

            let html = '';
            matches.forEach(m => {
                const isLive = m.is_live;
                const statusBadgeClass = isLive 
                    ? 'bg-red-500/20 text-red-400 border-red-500/40 animate-pulse' 
                    : (m.status_badge === 'Stumps' ? 'bg-amber-500/20 text-amber-400 border-amber-500/40' : 'bg-slate-800 text-slate-300 border-slate-700');

                html += `
                <div class="glass-card-gold rounded-2xl p-5 border border-cyan-500/20 hover:border-amber-400/50 transition-all duration-300 shadow-xl group">
                    
                    <!-- Series & Status Header -->
                    <div class="flex items-center justify-between gap-2 pb-3 border-b border-slate-800/80 text-xs">
                        <span class="font-mono text-[11px] text-cyan-400 truncate max-w-[65%]" title="${escapeHtml(m.series)}">
