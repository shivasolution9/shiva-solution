        function openComplianceModal(tabKey = 'privacy') {
            document.getElementById('complianceModal').classList.remove('hidden');
            switchComplianceTab(tabKey);
        }

        function closeComplianceModal() {
            document.getElementById('complianceModal').classList.add('hidden');
        }

        function switchComplianceTab(tabKey) {
            const data = COMPLIANCE_DOCS[tabKey] || COMPLIANCE_DOCS.privacy;
            document.getElementById('complianceModalTitle').textContent = data.title;
            document.getElementById('complianceModalBody').innerHTML = data.html;

            ['privacy', 'terms', 'gambling'].forEach(key => {
                const btn = document.getElementById(`compTabBtn-${key}`);
                if (btn) {
                    if (key === tabKey) {
                        btn.className = 'px-3.5 py-2 font-bold border-b-2 border-amber-400 text-amber-400 transition';
                    } else {
                        btn.className = 'px-3.5 py-2 font-bold border-b-2 border-transparent text-slate-400 hover:text-white transition';
                    }
                }
            });
        }

        // Auto-initialize Cricbuzz live telemetry & Single-page blogs on page load
        document.addEventListener('DOMContentLoaded', () => {
            // Blog system setup
            updateOwnerUI();
            renderBlogs();
            syncBlogsFromMongoDB();

            // Handle URL anchor or query params
            const hash = window.location.hash;
            if (hash) {
                if (hash.includes('today-live')) filterByCategory('Today Live Match');
                else if (hash.includes('pitch-reports')) filterByCategory('Pitch Report');
                else if (hash.includes('match-reports')) filterByCategory('Match Report');
                else if (hash.includes('blogs')) {
                    const el = document.getElementById('blogs');
                    if (el) setTimeout(() => el.scrollIntoView({ behavior: 'smooth' }), 300);
                }
            }

            // Cricbuzz live setup
            loadCricbuzzScores();
            loadBallByBallTelemetry();
            loadCricbuzzNews();

            // Real-time auto-poll for live scores & ball-by-ball updates every 15 seconds
            setInterval(() => {
                loadCricbuzzScores();
                loadBallByBallTelemetry();
            }, 15000);

            // Auto-poll cricket news every 60 seconds
            setInterval(loadCricbuzzNews, 60000);
        });
    </script>
