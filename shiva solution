        function showToast(msg) {
            const toast = document.getElementById('toastNotification');
            const toastMsg = document.getElementById('toastMessage');
            if (!toast || !toastMsg) return;

            toastMsg.textContent = msg;
            toast.classList.remove('opacity-0', '-translate-y-4', 'pointer-events-none');
            toast.classList.add('opacity-100', 'translate-y-0');

            if (toastTimeout) clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
            }, 3000);
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeReader();
                closeEditor();
                closeOwnerLoginModal();
                closeChangePinModal();
                closeLeadsModal();
            }
        });

        async function syncBlogsFromMongoDB() {
            try {
                let fetchedBlogs = null;
                try {
                    const res = await fetch('/api/blogs');
                    if (res.ok) {
                        const data = await res.json();
                        if (data && data.blogs && Array.isArray(data.blogs) && data.blogs.length > 0) {
                            fetchedBlogs = data.blogs;
                        }
                    }
                } catch (e) {}

                if (!fetchedBlogs) {
                    try {
                        const fileRes = await fetch('database/blogs.json');
                        if (fileRes.ok) {
                            const fileData = await fileRes.json();
                            if (Array.isArray(fileData) && fileData.length > 0) {
                                fetchedBlogs = fileData;
                            }
                        }
                    } catch (e) {}
                }

                if (fetchedBlogs && fetchedBlogs.length > 0) {
                    saveStoredBlogs(fetchedBlogs);
                    renderBlogs();
                }
            } catch (err) {
                console.log('Blog sync info:', err);
            }
        }

        // Real-time synchronization across browser tabs (Admin -> Customer View)
        window.addEventListener('storage', (e) => {
            if (e.key === STORAGE_KEY_BLOGS || e.key === 'shivasolution_blogs_v2') {
                renderBlogs();
            }
        });

        function renderBlogSidebarScores(matches) {
            const container = document.getElementById('blogSidebarLiveScores');
            if (!container || !matches) return;

            let html = '';
            matches.slice(0, 4).forEach(m => {
                const isLive = m.is_live;
                html += `
                <div class="p-3 rounded-2xl bg-slate-950/80 border border-slate-800 text-xs font-mono space-y-1.5 hover:border-amber-400/40 transition">
                    <div class="flex items-center justify-between text-[10px] text-slate-400">
                        <span class="truncate max-w-[70%] text-cyan-400">${escapeHtml(m.title)}</span>
                        <span class="${isLive ? 'text-red-400 font-bold animate-pulse' : 'text-amber-400'}">${escapeHtml(m.status_badge || 'Result')}</span>
                    </div>
                    <div class="flex items-center justify-between text-slate-200 font-bold">
                        <span>${escapeHtml(m.team1_short || m.team1)}</span>
                        <span class="text-white">${escapeHtml(m.team1_score || '-')}</span>
                    </div>
                    <div class="flex items-center justify-between text-slate-200 font-bold">
                        <span>${escapeHtml(m.team2_short || m.team2)}</span>
                        <span class="text-amber-300">${escapeHtml(m.team2_score || '-')}</span>
                    </div>
                    <div class="text-[11px] text-emerald-400 font-semibold pt-1 border-t border-slate-900 truncate">
                        ⚡ ${escapeHtml(m.status)}
                    </div>
                </div>
                `;
            });
            container.innerHTML = html;
        }

        function renderBlogSidebarNews(news) {
            const container = document.getElementById('blogSidebarLiveNews');
            if (!container || !news) return;

            let html = '';
            news.slice(0, 4).forEach(item => {
                html += `
                <a href="${escapeHtml(item.url || 'https://www.cricbuzz.com/cricket-news')}" target="_blank" class="block p-2.5 rounded-2xl bg-slate-950/80 border border-slate-800 hover:border-amber-400/40 transition group">
                    <div class="flex items-start gap-2.5">
                        <div class="w-12 h-12 rounded-xl overflow-hidden bg-slate-900 flex-shrink-0">
                            <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.headline)}" class="w-full h-full object-cover group-hover:scale-105 transition" onerror="this.src='https://static.cricbuzz.com/a/img/v1/i1/c582022/i.jpg'">
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold text-white group-hover:text-amber-300 transition line-clamp-2 leading-snug">
                                ${escapeHtml(item.headline)}
                            </h4>
                            <div class="flex items-center gap-2 mt-1 text-[10px] text-slate-400 font-mono">
                                <span class="text-amber-400">${escapeHtml(item.category || 'News')}</span>
                                <span>&bull;</span>
                                <span>${escapeHtml(item.datePublished || 'Recent')}</span>
                            </div>
                        </div>
                    </div>
                </a>
                `;
            });
            container.innerHTML = html;
        }

        // ================= COMPLIANCE MODAL (GOOGLE ADS & META ADS AUDIT) =================
