        async function handleAdminLogin(event) {
            event.preventDefault();
            const usernameInput = document.getElementById('adminUsername').value.trim();
            const passwordInput = document.getElementById('adminPassword').value.trim();
            const errorAlert = document.getElementById('loginErrorAlert');
            const errorMsg = document.getElementById('loginErrorMessage');
            const rateLimitWarning = document.getElementById('rateLimitWarning');
            const attemptsBadge = document.getElementById('loginAttemptsBadge');
            const submitBtn = document.getElementById('loginSubmitBtn');

            errorAlert.classList.add('hidden');
            rateLimitWarning.classList.add('hidden');
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<span>Verifying credentials...</span>`;

            try {
                // Call /api/auth/login with Rate-Limiting Protection
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: usernameInput, password: passwordInput })
                });

                if (response.status === 429) {
                    // Rate Limit Triggered (Anti-DoS Protection)
                    rateLimitWarning.classList.remove('hidden');
                    document.getElementById('rateLimitWarningText').textContent = 'Too many attempts. Anti-DoS Lockout active for 15 minutes.';
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = `<span>Sign In to Dashboard</span>`;
                    return;
                }

                const result = await response.json();

                if (response.ok && result.status === 'success') {
                    // SUCCESSFUL LOGIN
                    currentAuthToken = result.token || 'verified_token_' + Date.now();
                    currentUsername = usernameInput;
                    sessionStorage.setItem('shiva_admin_token', currentAuthToken);
                    sessionStorage.setItem('shiva_admin_username', currentUsername);
                    sessionStorage.setItem('shiva_owner_auth', 'true');
                    sessionStorage.setItem('shiva_owner_key', passwordInput);
                    localStorage.setItem('shiva_owner_pin', passwordInput);

                    showToast('👋 Welcome back, Administrator!');
                    showDashboard();
                    return;
                } else {
                    failedAttempts++;
                    const remaining = Math.max(0, 5 - failedAttempts);
                    attemptsBadge.textContent = `Attempts left: ${remaining}/5`;
                    errorMsg.textContent = result.message || 'Invalid username or password. Access Denied.';
                    errorAlert.classList.remove('hidden');
                }
            } catch (err) {
                // Offline fallback authentication against verified PIN
                if ((usernameInput.toLowerCase() === 'admin' || usernameInput.toLowerCase() === 'shiva') && passwordInput === OWNER_FALLBACK_PIN) {
                    currentAuthToken = 'offline_verified_token_' + Date.now();
                    currentUsername = usernameInput;
                    sessionStorage.setItem('shiva_admin_token', currentAuthToken);
                    sessionStorage.setItem('shiva_admin_username', currentUsername);
                    sessionStorage.setItem('shiva_owner_auth', 'true');
                    sessionStorage.setItem('shiva_owner_key', passwordInput);
                    localStorage.setItem('shiva_owner_pin', passwordInput);

                    showToast('🛡️ Authenticated via Local Security Guard');
                    showDashboard();
                    return;
                }

                failedAttempts++;
                errorMsg.textContent = 'Server response error. Ensure password matches proprietor passkey.';
                errorAlert.classList.remove('hidden');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = `<span>Sign In to Dashboard</span> <i data-lucide="arrow-right" class="w-4 h-4 text-zinc-900"></i>`;
                lucide.createIcons();
            }
        }

        function handleAdminLogout() {
            if (confirm('Sign out of SHIVA SOLUTION admin portal?')) {
                currentAuthToken = '';
                sessionStorage.removeItem('shiva_admin_token');
                sessionStorage.removeItem('shiva_admin_username');
                sessionStorage.removeItem('shiva_owner_auth');
                showToast('🔒 Signed out successfully.');
                showLogin();
            }
        }

        function togglePasswordVisibility() {
            const passInput = document.getElementById('adminPassword');
            const eyeIcon = document.getElementById('eyeIcon');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                eyeIcon.setAttribute('data-lucide', 'eye-off');
            } else {
                passInput.type = 'password';
                eyeIcon.setAttribute('data-lucide', 'eye');
            }
            lucide.createIcons();
        }

        // 2. TAB NAVIGATION
        function switchTab(tabName) {
            document.querySelectorAll('.tab-pane').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = 'tab-btn px-3 py-1.5 rounded-md text-xs font-medium transition flex items-center gap-2 text-zinc-400 hover:text-white hover:bg-zinc-900';
            });

            const targetPane = document.getElementById(`tabContent-${tabName}`);
            const targetBtn = document.getElementById(`tabBtn-${tabName}`);
            if (targetPane) targetPane.classList.remove('hidden');
            if (targetBtn) targetBtn.className = 'tab-btn px-3 py-1.5 rounded-md text-xs font-medium transition flex items-center gap-2 bg-zinc-800 text-white';
            lucide.createIcons();
        }

        // 3. BLOG CMS MANAGEMENT
        async function loadAdminBlogs() {
            try {
                const stored = localStorage.getItem('shivasolution_blogs_v2');
                if (stored) {
                    const parsed = JSON.parse(stored);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        adminBlogs = parsed;
                    }
                }
            } catch (e) {}

            try {
                let fetchedBlogs = null;
                const res = await fetch('/api/blogs');
                if (res.ok) {
                    const data = await res.json();
                    fetchedBlogs = data.blogs;
                }

                if (!fetchedBlogs || fetchedBlogs.length === 0) {
                    const localRes = await fetch('database/blogs.json');
                    if (localRes.ok) fetchedBlogs = await localRes.json();
                }

                if (fetchedBlogs && Array.isArray(fetchedBlogs) && fetchedBlogs.length > 0) {
                    adminBlogs = fetchedBlogs;
                    try {
                        localStorage.setItem('shivasolution_blogs_v2', JSON.stringify(adminBlogs));
                    } catch (e) {}
                }
            } catch (e) {
                console.log('Using local cached blogs:', e);
            }

            renderBlogsTable();
            document.getElementById('kpiTotalBlogs').textContent = adminBlogs.length;
            document.getElementById('tabBadgeBlogsCount').textContent = adminBlogs.length;
        }

        function renderBlogsTable() {
            const tbody = document.getElementById('adminBlogsTableBody');
            if (!tbody) return;

            if (adminBlogs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-zinc-500">No blog articles found.</td></tr>`;
                return;
            }

            tbody.innerHTML = adminBlogs.map(blog => {
                const badgeColor = blog.category === 'Today Live Match' ? 'bg-red-950/80 text-red-400 border-red-500/30' :
                                   blog.category === 'Pitch Report' ? 'bg-amber-950/80 text-amber-400 border-amber-500/30' :
                                   blog.category === 'Match Report' ? 'bg-blue-950/80 text-blue-400 border-blue-500/30' :
                                   'bg-purple-950/80 text-purple-400 border-purple-500/30';
                return `
                    <tr class="hover:bg-zinc-900/40 transition">
                        <td class="p-3.5">
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium border ${badgeColor}">
                                <span>${escapeHtml(blog.emoji || '🏏')}</span>
                                <span>${escapeHtml(blog.category)}</span>
                            </span>
                        </td>
                        <td class="p-3.5 font-semibold text-white max-w-xs truncate">
                            ${escapeHtml(blog.title)}
                        </td>
                        <td class="p-3.5 text-zinc-400">${escapeHtml(blog.author || 'Editorial')}</td>
                        <td class="p-3.5 font-mono text-zinc-400 text-[11px]">${escapeHtml(blog.readTime || '4 min')}</td>
                        <td class="p-3.5 text-zinc-500 text-[11px]">${escapeHtml(blog.date || 'Today')}</td>
                        <td class="p-3.5 text-right space-x-1">
                            <button onclick="openEditBlogModal('${blog.id}')" class="px-2 py-1 rounded bg-zinc-900 hover:bg-zinc-800 text-zinc-300 border border-zinc-700 text-[11px] transition">
                                Edit
                            </button>
                            <button onclick="deleteBlogById('${blog.id}')" class="px-2 py-1 rounded bg-zinc-900 hover:bg-red-950 text-red-400 border border-zinc-800 hover:border-red-500/30 text-[11px] transition">
                                Delete
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function openNewBlogModal() {
            document.getElementById('blogEditorModalTitle').textContent = 'Write New Blog Post';
            document.getElementById('editorSubmitBtn').textContent = 'Publish Blog';
            document.getElementById('adminBlogForm').reset();
            document.getElementById('editorBlogId').value = '';
            document.getElementById('editorAuthor').value = 'SHIVA SOLUTION Cricket Desk';
            document.getElementById('editorReadTime').value = '4 min read';
            document.getElementById('editorKeywords').value = 'SHIVA SOLUTION, cricket, today live match, pitch report';
            document.getElementById('blogEditorModal').classList.remove('hidden');
            lucide.createIcons();
        }

        function openEditBlogModal(id) {
            const blog = adminBlogs.find(b => b.id === id);
            if (!blog) return;

            document.getElementById('blogEditorModalTitle').textContent = 'Edit Blog Post';
            document.getElementById('editorSubmitBtn').textContent = 'Save Changes';
            document.getElementById('editorBlogId').value = blog.id;
            document.getElementById('editorTitle').value = blog.title || '';
            document.getElementById('editorCategory').value = blog.category || 'Today Live Match';
            document.getElementById('editorEmoji').value = blog.emoji || '🏏';
            document.getElementById('editorAuthor').value = blog.author || '';
            document.getElementById('editorReadTime').value = blog.readTime || '4 min read';
            document.getElementById('editorExcerpt').value = blog.excerpt || '';
            document.getElementById('editorContent').value = blog.content || '';
            document.getElementById('editorKeywords').value = (blog.keywords || []).join(', ');
            document.getElementById('blogEditorModal').classList.remove('hidden');
            lucide.createIcons();
        }

        function closeBlogEditorModal() {
            document.getElementById('blogEditorModal').classList.add('hidden');
        }

        async function handleBlogFormSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('editorBlogId').value.trim();
            const title = document.getElementById('editorTitle').value.trim();
            const category = document.getElementById('editorCategory').value;
            const emoji = document.getElementById('editorEmoji').value.trim() || '🏏';
            const author = document.getElementById('editorAuthor').value.trim() || 'SHIVA SOLUTION Editorial';
            const readTime = document.getElementById('editorReadTime').value.trim() || '4 min read';
            const excerpt = document.getElementById('editorExcerpt').value.trim();
            const content = document.getElementById('editorContent').value.trim();
            const kwRaw = document.getElementById('editorKeywords').value.trim();
            const keywords = kwRaw.split(',').map(s => s.trim()).filter(Boolean);

            const blogPayload = {
                id: id || ('blog-' + Date.now()),
                title,
                category,
                emoji,
                author,
                readTime,
                date: 'Recently Edited',
                excerpt,
                content,
                keywords
            };

            // Update in local state
            if (id) {
                const idx = adminBlogs.findIndex(b => b.id === id);
                if (idx !== -1) adminBlogs[idx] = blogPayload;
            } else {
                adminBlogs.unshift(blogPayload);
            }

            // Immediately persist to localStorage for instant public display across tabs
            try {
                localStorage.setItem('shivasolution_blogs_v2', JSON.stringify(adminBlogs));
            } catch (err) {
                console.error('LocalStorage write error:', err);
            }

            renderBlogsTable();
            closeBlogEditorModal();
            showToast('✅ Blog successfully saved & published!');

            // Sync with backend API
            const pin = sessionStorage.getItem('shiva_owner_key') || OWNER_FALLBACK_PIN;
            fetch('/api/blogs', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Owner-Pin': pin
                },
                body: JSON.stringify(blogPayload)
            }).catch(() => {});
        }

        async function deleteBlogById(id) {
            const blog = adminBlogs.find(b => b.id === id);
            if (!blog) return;

            if (confirm(`Are you sure you want to delete this blog post?\n\n"${blog.title}"`)) {
                adminBlogs = adminBlogs.filter(b => b.id !== id);
                try {
                    localStorage.setItem('shivasolution_blogs_v2', JSON.stringify(adminBlogs));
                } catch (err) {}
                renderBlogsTable();
                showToast('🗑️ Blog post removed.');

                const pin = sessionStorage.getItem('shiva_owner_key') || OWNER_FALLBACK_PIN;
                fetch(`/api/blogs?id=${encodeURIComponent(id)}`, {
                    method: 'DELETE',
                    headers: { 'X-Owner-Pin': pin }
                }).catch(() => {});
            }
        }

        // 4. CUSTOMER LEADS CRM
        async function loadAdminLeads() {
            const pin = sessionStorage.getItem('shiva_owner_key') || OWNER_FALLBACK_PIN;
            try {
                let leads = [];
                const res = await fetch(`/api/leads?pin=${encodeURIComponent(pin)}`);
                if (res.ok) {
                    const data = await res.json();
                    leads = data.leads || [];
                }

                if (leads.length === 0) {
                    const fileRes = await fetch('database/leads.json');
                    if (fileRes.ok) leads = await fileRes.json();
                }

                adminLeads = leads;
            } catch (err) {
                console.log('Error loading leads:', err);
            }

            renderLeadsTable();
            document.getElementById('kpiTotalLeads').textContent = adminLeads.length;
            document.getElementById('tabBadgeLeadsCount').textContent = adminLeads.length;
        }

        function renderLeadsTable() {
            const tbody = document.getElementById('adminLeadsTableBody');
            const recentContainer = document.getElementById('overviewRecentLeadsList');

            if (tbody) {
                if (adminLeads.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-zinc-500">No leads recorded yet. Submissions from index.html & blog.html will populate here.</td></tr>`;
                } else {
                    tbody.innerHTML = adminLeads.map((lead, idx) => `
                        <tr class="hover:bg-zinc-900/40 transition">
                            <td class="p-3.5 text-zinc-500">${idx + 1}</td>
                            <td class="p-3.5 font-mono font-bold text-emerald-400">+91 ${escapeHtml(lead.phone)}</td>
                            <td class="p-3.5 text-white">${escapeHtml(lead.name || 'Sports Reader')}</td>
                            <td class="p-3.5 text-amber-300 text-[11px]">${escapeHtml(lead.preferences || 'Cricket Alerts')}</td>
                            <td class="p-3.5 text-zinc-400 text-[11px]">${escapeHtml(lead.source || 'Website Form')}</td>
                            <td class="p-3.5 text-zinc-500 font-mono text-[10px]">${escapeHtml(lead.timestamp || '-')}</td>
                            <td class="p-3.5 text-right">
                                <a href="https://wa.me/91${encodeURIComponent(lead.phone)}?text=HELLO!%20SHIVA%20SOLUTION%20SPORTS%20DESK" target="_blank"
                                   class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-emerald-950/80 hover:bg-emerald-900 text-emerald-400 border border-emerald-500/30 text-[11px] font-semibold transition">
                                    <span>WhatsApp</span> &rarr;
                                </a>
                            </td>
                        </tr>
                    `).join('');
                }
            }

            if (recentContainer) {
                if (adminLeads.length === 0) {
                    recentContainer.innerHTML = `<div class="text-xs text-zinc-500 text-center py-4">No leads yet.</div>`;
                } else {
                    recentContainer.innerHTML = adminLeads.slice(0, 5).map(lead => `
                        <div class="p-2.5 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-between text-xs">
                            <div>
                                <span class="font-mono text-emerald-400 font-bold">+91 ${escapeHtml(lead.phone)}</span>
                                <span class="text-zinc-500 text-[10px] ml-2">${escapeHtml(lead.source || 'Web')}</span>
                            </div>
                            <span class="text-amber-400 text-[11px] font-mono">${escapeHtml(lead.preferences || 'Cricket')}</span>
                        </div>
                    `).join('');
                }
            }
        }

        function exportLeadsCsv() {
            const pin = sessionStorage.getItem('shiva_owner_key') || OWNER_FALLBACK_PIN;
            window.open(`/api/leads/export?pin=${encodeURIComponent(pin)}`, '_blank');
            showToast('📊 Exporting customer leads CSV...');
        }

        // 5. ANTI-DOS SHIELD & TELEMETRY
        async function fetchSecurityStats() {
            const pre = document.getElementById('securityStatsPre');
            try {
                const res = await fetch('/api/security/stats');
                if (res.ok) {
                    const data = await res.json();
                    if (pre) pre.textContent = JSON.stringify(data, null, 2);
                    const kpiShield = document.getElementById('kpiShieldStatus');
                    if (kpiShield) kpiShield.textContent = '60 req/hr';
                    const windowLabel = document.getElementById('publicApiWindowText');
                    if (windowLabel && data.api_rate_limit) windowLabel.textContent = data.api_rate_limit;
                } else {
                    if (pre) pre.textContent = 'Server returned HTTP ' + res.status;
                }
            } catch (e) {
                if (pre) pre.textContent = 'Offline Telemetry Monitor Active:\n- Algorithm: In-Memory Sliding Window Bucket\n- Rate Limit: 60 requests / hour per IP\n- Auth Lockout: 5 failed attempts / 15 minutes';
            }
        }

        async function testRateLimiterPing() {
            const statusEl = document.getElementById('pingStatusText');
            statusEl.textContent = 'Pinging...';
            const t0 = performance.now();
            try {
                const res = await fetch('/api/status');
                const t1 = performance.now();
                statusEl.textContent = `Latency: ${(t1 - t0).toFixed(1)}ms (HTTP ${res.status})`;
            } catch (e) {
                statusEl.textContent = 'Ping offline (Local)';
            }
        }

        async function simulateTrafficBurst() {
            const btn = document.getElementById('burstTestBtn');
            const resEl = document.getElementById('burstTestResult');
            btn.disabled = true;
            resEl.textContent = 'Firing 10 concurrent requests...';

            let completed = 0;
            let throttled = 0;
            const requests = [];

            for (let i = 0; i < 10; i++) {
                requests.push(fetch('/api/status').then(r => {
                    if (r.status === 429) throttled++;
                    else completed++;
                }).catch(() => {}));
            }

            await Promise.all(requests);
            btn.disabled = false;
            resEl.textContent = `Completed: ${completed} OK | Throttled (429): ${throttled} | Shield Protected 🛡️`;
            showToast(`Simulated traffic handled: ${completed} passed, ${throttled} throttled`);
        }

        // TOAST UTILITY
        let toastTimer = null;
        function showToast(message) {
            const toast = document.getElementById('toastNotification');
            const msgEl = document.getElementById('toastMessage');
            msgEl.textContent = message;
            toast.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
            toast.classList.add('opacity-100', 'translate-y-0');

            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }, 3000);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
    </script>
</body>
</html>

